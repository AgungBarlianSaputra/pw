/* RESET */
body {
    margin: 0;
    font-family: Arial, sans-serif;
}

/* 60% WARNA UTAMA */
body {
    background-color: #f5f5f5;
}

/* HEADER (30%) */
header {
    background-color: #2c3e50;
    color: white;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    margin: 10px;
    text-decoration: none;
}

/* HERO */
.hero {
    background-color: #34495e;
    color: white;
    text-align: center;
    padding: 50px;
}

/* 10% AKSEN */
.info {
    background-color: #e74c3c;
    color: white;
    text-align: center;
    padding: 10px;
}

/* KONTEN UTAMA */
main {
    padding: 20px;
}

/* MENU */
.menu {
    margin-bottom: 30px;
}

/* CARD */
.card {
    background: white;
    padding: 15px;
    margin: 10px 0;
    border-radius: 8px;
}

/* FOOTER */
footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 10px;
}
